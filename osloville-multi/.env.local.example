# OsloVille self-hosted staging configuration
# Copy to .env before running docker compose up.

POSTGRES_USER=postgres
# Use a strong unique password outside local development.
POSTGRES_PASSWORD=change-me-for-staging
POSTGRES_DB=osloville

# Browser origin(s), comma-separated. Use the exact HTTPS staging origin in production.
CORS_ORIGIN=http://localhost:3000

# Required to read the protected playtest report queue and invoke maintenance endpoints.
# Generate a long random secret; never expose it in NEXT_PUBLIC_* variables.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Optional: Google OAuth web client id. Leave empty to use demo/guest entry only.
GOOGLE_CLIENT_ID=

# Frontend runtime target (docker compose sets these for local use).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
